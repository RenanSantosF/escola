; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Turma Viva: Recreio"
config/description="Simulador casual de vida escolar, exploração e brincadeiras de recreio."
config/version="0.1.0"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
boot_splash/bg_color=Color(1, 0.886, 0.498, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

FTSplash="*res://addons/ft_splash/ft_splash.gd"
Settings="*res://autoloads/settings_manager.gd"
SaveManager="*res://autoloads/save_manager.gd"
AudioManager="*res://autoloads/audio_manager.gd"
GameManager="*res://autoloads/game_manager.gd"
Effects="*res://autoloads/effects.gd"
AdsManager="*res://autoloads/ads_manager.gd"
NetworkManager="*res://autoloads/network_manager.gd"
Telemetry="*res://autoloads/telemetry.gd"
AccountManager="*res://autoloads/account_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="npc"
3d_physics/layer_4="props"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
3d/sleep_threshold_linear=0.2

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/positional_shadow/atlas_size=0
lights_and_shadows/positional_shadow/atlas_size.mobile=0
occlusion_culling/use_occlusion_culling=true
environment/defaults/default_clear_color=Color(0.6, 0.78, 0.95, 1)
anti_aliasing/quality/msaa_3d=0
